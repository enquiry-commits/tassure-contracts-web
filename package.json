{
  "name": "tassure-contracts-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:proposal": "eslint lib/template-contract.ts lib/proposal-plan.ts scripts/tag-templates.ts scripts/template-map.ts scripts/validate-templates.ts scripts/verify-proposal-plan.ts scripts/verify-docgen.ts",
    "inspect-docx": "tsx scripts/inspect-docx.ts",
    "tag-templates": "tsx scripts/tag-templates.ts",
    "template-map": "tsx scripts/template-map.ts",
    "validate-templates": "tsx scripts/validate-templates.ts",
    "verify-docgen": "tsx scripts/verify-docgen.ts",
    "verify-proposal-plan": "tsx scripts/verify-proposal-plan.ts",
    "visual:generate": "tsx scripts/generate-visual-fixtures.ts",
    "visual:render": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/render-visual-fixtures.ps1",
    "visual:qa": "npm run visual:generate && npm run visual:render",
    "qa:worker": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-visual-qa-worker.ps1",
    "qa:worker:once": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-visual-qa-worker.ps1 -Once",
    "typecheck": "tsc --noEmit",
    "quality:proposal": "npm run typecheck && npm run lint:proposal && npm run validate-templates && npm run template-map && npm run verify-proposal-plan && npm run verify-docgen && npm run build"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "@xmldom/xmldom": "^0.9.10",
    "docx": "^9.7.0",
    "jszip": "^3.10.1",
    "next": "16.2.6",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
